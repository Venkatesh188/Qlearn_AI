# OpenAI-compatible endpoint. OpenRouter by default; point at Crusoe / Nebius / Vultr inference to swap providers.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=anthropic/claude-haiku-4.5
# Optional: enriches "topic" courses with Brave web search results.
BRAVE_API_KEY=
# Max output tokens per lesson (lower it if your provider says you can't afford the request).
LESSON_MAX_TOKENS=12000
# Templates: each picks its own text model (all via LLM_BASE_URL). openai/ models get reasoning effort "low".
MEME_TEXT_MODEL=openai/gpt-5.4-mini
STORY_TEXT_MODEL=anthropic/claude-haiku-4.5
# Meme images (Nano Banana). A failed image falls back to a caption callout.
IMAGE_MODEL=google/gemini-2.5-flash-image
MAX_MEMES_PER_LESSON=4
# AI tutor on the lesson page.
TUTOR_MODEL=anthropic/claude-haiku-4.5
# Optional: Supabase storage. Both set → Postgres tables + Storage bucket (apply
# supabase/migrations/0001_init.sql first). Unset → local JSON files in data/.
# Dashboard → Project Settings → API. The service-role key is a SECRET: backend only, never the frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_IMAGE_BUCKET=course-images
